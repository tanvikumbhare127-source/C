#include <stdio.h>

int main() {
    int i, j;

    // Outer loop controls the rows
    for (i = 1; i <= 5; i++) {
        
        // Inner loop controls the columns for each row
        for (j = 1; j <= 5; j++) {
            printf("%4d", i * j);
        }
        
        // Move to the next line after each row is complete
        printf("\n");
    }

    return 0;
}